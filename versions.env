# Pinned upstream sources. fetch.sh refuses any archive whose sha256 differs.
# Bumping a version: update VERSION, URL and SHA256 together, note it in docs/STATUS.md.

OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

STRONGSWAN_VERSION=6.1.0
STRONGSWAN_URL=https://download.strongswan.org/strongswan-${STRONGSWAN_VERSION}.tar.bz2
STRONGSWAN_SHA256=fe6c97481298767213cfc2e9a1da29fdd8018d481ff4cb9cf0283099654f20d4

# Runtime directory for charon pidfile and default vici socket
# (compiled in; created by the app's helper).
CHARON_PIDDIR=/var/run/sluice

# Build targets
MACOS_MIN=15.0
ARCHS="arm64 x86_64"
