# Pinned upstream sources. fetch.sh refuses any archive whose sha256 differs.
# Bumping a version: update VERSION, URL and SHA256 together, note it in docs/STATUS.md.

OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

STRONGSWAN_VERSION=6.1.0
STRONGSWAN_URL=https://download.strongswan.org/strongswan-${STRONGSWAN_VERSION}.tar.bz2
STRONGSWAN_SHA256=fe6c97481298767213cfc2e9a1da29fdd8018d481ff4cb9cf0283099654f20d4

# No release tarballs upstream: GitHub tag archive (needs autotools below).
OPENFORTIVPN_VERSION=1.24.1
OPENFORTIVPN_URL=https://github.com/adrienverge/openfortivpn/archive/refs/tags/v${OPENFORTIVPN_VERSION}.tar.gz
OPENFORTIVPN_SHA256=c40d33acd97b89c2e943bfd839c19b69e5a7a5997052e2fc9a595602745c0465

# Build-only tools (scripts/build-tools.sh -> build/tools), never shipped.
# macOS m4 1.4.6 is too old for autoconf; pkg.m4 comes from pkg-config.
M4_VERSION=1.4.21
M4_URL=https://ftp.gnu.org/gnu/m4/m4-${M4_VERSION}.tar.xz
M4_SHA256=f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66
AUTOCONF_VERSION=2.73
AUTOCONF_URL=https://ftp.gnu.org/gnu/autoconf/autoconf-${AUTOCONF_VERSION}.tar.xz
AUTOCONF_SHA256=9fd672b1c8425fac2fa67fa0477b990987268b90ff36d5f016dae57be0d6b52e
AUTOMAKE_VERSION=1.19
AUTOMAKE_URL=https://ftp.gnu.org/gnu/automake/automake-${AUTOMAKE_VERSION}.tar.xz
AUTOMAKE_SHA256=e3e2c2e3abf37898138db5b6c1d1dc35c9160c5978be7947d2c741705251d445
PKGCONFIG_VERSION=0.29.2
PKGCONFIG_URL=https://pkgconfig.freedesktop.org/releases/pkg-config-${PKGCONFIG_VERSION}.tar.gz
PKGCONFIG_SHA256=6fc69c01688c9458a57eb9a1664c9aba372ccda420a02bf4429fe610e7e7d591

# Runtime directory for charon pidfile and default vici socket
# (compiled in; created by the app's helper).
CHARON_PIDDIR=/var/run/sluice

# Build targets
MACOS_MIN=15.0
ARCHS="arm64 x86_64"
