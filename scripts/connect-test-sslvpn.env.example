# Copy outside the repo (e.g. ~/.config/sluice/fortigate-sslvpn.env), chmod 600, fill in.
# Usage: sudo scripts/connect-test-sslvpn.sh ~/.config/sluice/fortigate-sslvpn.env

GATEWAY=vpn.example.com     # FortiGate SSL-VPN host
PORT=443                    # SSL-VPN port (often 443 or 10443)
USERNAME='user'
PASSWORD='...'              # leave empty ('') to be asked at start
REALM=''                    # optional SSL-VPN realm
USER_AGENT=''               # optional; e.g. 'FortiClient' if the gateway rejects
                            # other clients with "Permission denied"
TRUSTED_CERT=''             # sha256 of the gateway cert; leave empty on the first run,
                            # the test prints the digest to put here
